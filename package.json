{
  "name": "voice-workspace",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "npm run db:migrate -w backend"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
