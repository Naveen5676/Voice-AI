{
  "name": "LiveKit Voice Agent Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "LiveKit Agent Health Endpoint",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r agent/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
