NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://voice_app:replace-with-password@localhost:5432/voice_studio
# Generate a random secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Public browser URL. Production: https://your-service.onrender.com
BETTER_AUTH_URL=http://localhost:5173
# Set to 1 behind Render's reverse proxy; keep 0 for direct local connections.
TRUST_PROXY_HOPS=0

# Voice is optional. Set all four values to enable browser calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_SERVICE_SECRET=
# Must match the Python worker's dispatch name.
LIVEKIT_AGENT_NAME=my-agent
# Local worker deployment. Use production for a deployed production worker.
LIVEKIT_AGENT_DEPLOYMENT=voice-studio-local
WEB_CALL_MAX_SECONDS=600
WEB_CALL_JOIN_SECONDS=45
WEB_CALL_READY_SECONDS=30
