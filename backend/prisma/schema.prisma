generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
  moduleFormat        = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Agent {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id")
  name        String   @db.VarChar(100)
  prompt      String
  templateId  String   @default("custom") @map("template_id")
  createdAt   DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(dbgenerated("clock_timestamp()")) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  voiceCalls  VoiceCall[]

  @@index([ownerId, updatedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "agents_owner_updated_idx")
  @@map("agents")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("rateLimit")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("session")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(6)
  account       Account[]
  agents        Agent[]
  session       Session[]
  voiceCalls    VoiceCall[]
  @@map("user")
}

model VoiceCall {
  id                  String   @id @default(uuid()) @db.Uuid
  ownerId             String
  agentId             String   @db.Uuid
  idempotencyKey      String   @db.Uuid
  roomName            String   @unique
  participantIdentity String
  agentName           String
  prompt              String
  agentUpdatedAt      DateTime @db.Timestamptz(6)
  status              String   @default("pending")
  dispatchId          String?
  failureCode         String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  startedAt           DateTime? @db.Timestamptz(6)
  endedAt             DateTime? @db.Timestamptz(6)
  joinDeadline        DateTime @db.Timestamptz(6)
  readyDeadline       DateTime @db.Timestamptz(6)
  expiresAt           DateTime @db.Timestamptz(6)
  cleanupPending      Boolean  @default(false)
  cleanupLeaseUntil   DateTime? @db.Timestamptz(6)
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agent               Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  events              VoiceCallEvent[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
}

model VoiceCallEvent {
  id        String @id @default(uuid()) @db.Uuid
  callId    String @db.Uuid
  eventId   String @db.Uuid
  type      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  call      VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  @@unique([callId, eventId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}
