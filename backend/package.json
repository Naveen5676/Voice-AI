{
  "name": "backend",
  "private": true,
  "type": "commonjs",
  "exports": {
    "./validator/auth": "./src/validator/auth.validator.ts",
    "./validator/agent": "./src/validator/agent.validator.ts",
    "./validator/kb": "./src/validator/kb.validator.ts",
    "./agent-templates": "./src/config/agent-templates.ts"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "postinstall": "prisma generate --config prisma.config.ts",
    "build": "prisma generate --config prisma.config.ts && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:baseline": "prisma migrate resolve --config prisma.config.ts --applied 0001_initial",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.18",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "livekit-server-sdk": "^2.19.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2"
  }
}
